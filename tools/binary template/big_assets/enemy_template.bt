//------------------------------------------------
//--- 010 Editor v15.0.2 Binary Template
//
//      File: enemy_template.bt
//   Authors: Feiyang
//   Version: 0.4
//   Purpose: Roughly inspect one Gun Bros enemy template.
//  Category: Game / Big Assets
// File Mask: pack1_xga_0048_0x5457.bin
//------------------------------------------------

/*
    Sample file:
        pack1_xga_0048_0x5457.bin

    The compiled Flow Script is only colored and is not decoded.
    Its length varies per enemy, so it is measured instead of hardcoded.
*/

LittleEndian();


// ------------------------------------------------
// Colors
// ------------------------------------------------

const int COLOR_FLAG = 0xD0D0D0;
const int COLOR_REFERENCE = 0xFFE0B2;
const int COLOR_SCRIPT = 0xD7C6FF;


// ------------------------------------------------
// Part 1: Template flag
// ------------------------------------------------

struct TemplateFlag{
    ubyte debugScriptEnabled <format=decimal, bgcolor=COLOR_FLAG>;
} ;


// ------------------------------------------------
// Part 2: Common 8-byte refs
// ------------------------------------------------

/*
8X 75 26 00 Y

X = pack number [0,9]
Y = Yth type resource in this .big
Y varies from 1-4 bytes
*/

const uint32 STANDARD_PACK_HASH_BASE = 0x00267580;
const int STANDARD_PACK_MAX_NUMBER = 9;

typedef struct {
    uint32 stringPackHash <format=hex>;
    int32 stringIndex <format=hex>; // Zero-based. -1 means unused.
} CommonStringRef <read=commonStringRefFormat>;


string commonStringRefFormat(CommonStringRef &reference) {
    local int packNumber = reference.stringPackHash - STANDARD_PACK_HASH_BASE;
    local string result;

    if (packNumber >= 0 && packNumber <= STANDARD_PACK_MAX_NUMBER) {
        SPrintf(result, "pack%d str %d", packNumber, reference.stringIndex);
        return result;
    }

    SPrintf(
        result,
        "packHash 0x%08X str %d",
        reference.stringPackHash,
        reference.stringIndex
    );

    return result;
}


// ------------------------------------------------
// Part 3: Compiled Flow Script
// ------------------------------------------------

/*
    Runner sample:
        start = 0x09
        end   = 0x1B9
        size  = 432 bytes

    Other enemies can have a different script size. The size is not stored
    anywhere, so it is recovered by walking the length prefixes CScript::Load
    reads:

        ubyte  scriptPresent            zero means the block is this byte alone
        ubyte  discarded[6]
        ubyte  n; ubyte  exportSlots[n]
        ubyte  n; ubyte  unknown[n]
        ubyte  n; entry[n]              9 bytes per entry
        ubyte  n; dataBlock[n]          each: ubyte m + int16 values[m]
        ubyte  n; int16  variables[n]
        ubyte  n; state[n]              see below
        ubyte  n; code[n]               each: ubyte m + ubyte bytecode[m]

    One state is:

        ubyte  parentStateIndex
        ubyte  m; ubyte moveSequence[m]
        ubyte  n; handler[n]            each: ubyte eventId + one code block
        code                            on enter
        code                            on exit
*/

// Total size of the script block that starts at startPos.
int64 flowScriptSize(int64 startPos) {
    local int64 pos = startPos;
    local int tableCount;
    local int handlerCount;
    local int i;
    local int j;

    if (ReadUByte(pos) == 0) {
        return 1;
    }

    pos += 1; // scriptPresent
    pos += 6; // bytes the loader reads and throws away

    // Export slots.
    tableCount = ReadUByte(pos);
    pos += 1 + tableCount;

    // Second byte table, empty in every enemy template.
    tableCount = ReadUByte(pos);
    pos += 1 + tableCount;

    // Resource table, 9 bytes per entry.
    tableCount = ReadUByte(pos);
    pos += 1 + tableCount * 9;

    // Data blocks, each one a length prefixed int16 array.
    tableCount = ReadUByte(pos);
    pos += 1;
    for (i = 0; i < tableCount; i++) {
        pos += 1 + ReadUByte(pos) * 2;
    }

    // Initial values of the script variables.
    tableCount = ReadUByte(pos);
    pos += 1 + tableCount * 2;

    // States.
    tableCount = ReadUByte(pos);
    pos += 1;
    for (i = 0; i < tableCount; i++) {
        pos += 1;                   // parent state index
        pos += 1 + ReadUByte(pos);  // move sequence

        handlerCount = ReadUByte(pos);
        pos += 1;
        for (j = 0; j < handlerCount; j++) {
            pos += 1;                   // event id
            pos += 1 + ReadUByte(pos);  // handler code
        }

        pos += 1 + ReadUByte(pos);  // on enter
        pos += 1 + ReadUByte(pos);  // on exit
    }

    // Functions.
    tableCount = ReadUByte(pos);
    pos += 1;
    for (i = 0; i < tableCount; i++) {
        pos += 1 + ReadUByte(pos);
    }

    return pos - startPos;
}


struct CompiledFlowScript{
    local int64 scriptSize = flowScriptSize(FTell());
    ubyte data[scriptSize] <format=hex, bgcolor=COLOR_SCRIPT>;
} ;


// ------------------------------------------------
// Main
// ------------------------------------------------

TemplateFlag templateFlag;
CommonStringRef scriptNameReference <bgcolor=COLOR_REFERENCE>;
CompiledFlowScript compiledFlowScript;
